{
  "manifest_version": 3,
  "name": "Rank Peek — my-view SERP tracker",
  "version": "0.9.0",
  "description": "Auto-sweeps your keyword/geo list through Google using YOUR own browser session and reports each tracked domain's real position.",
  "permissions": ["storage", "tabs", "alarms", "notifications"],
  "host_permissions": [
    "*://www.google.com/*",
    "*://www.google.fr/*",
    "*://www.google.it/*",
    "*://www.google.es/*",
    "*://www.google.gr/*",
    "*://www.google.pt/*",
    "*://www.google.de/*",
    "*://www.google.co.uk/*",
    "*://www.google.pl/*",
    "*://www.google.nl/*",
    "*://www.google.com.br/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://api.telegram.org/*"
  ],
  "icons": { "16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png" },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png" }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.google.com/search*",
        "*://www.google.fr/search*",
        "*://www.google.it/search*",
        "*://www.google.es/search*",
        "*://www.google.gr/search*",
        "*://www.google.pt/search*",
        "*://www.google.de/search*",
        "*://www.google.co.uk/search*",
        "*://www.google.pl/search*",
        "*://www.google.nl/search*",
        "*://www.google.com.br/search*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
